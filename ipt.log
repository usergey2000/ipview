-A RH-Firewall-1-INPUT -m state --state NEW  -p tcp -m tcp --dport 22    -j ACCEPT
-A RH-Firewall-1-INPUT -m state --state NEW  -p tcp -m tcp --dport 80    -j ACCEPT
-A RH-Firewall-1-INPUT -m state --state NEW  -p tcp -m tcp --dport 443   -j ACCEPT
#
#-A RH-Firewall-1-INPUT --source 131.156.85.0/24 -m state --state NEW -m tcp -p tcp --dport 22  -m comment --comment "sshd"   -j ACCEPT
#-A RH-Firewall-1-INPUT --source 10.0.0.0/8      -m state --state NEW -m tcp -p tcp --dport 22  -m comment --comment "sshd"   -j ACCEPT
#
-A RH-Firewall-1-INPUT -m state --state NEW -m tcp -p tcp --dport 389 --source 131.156.85.0/24  -m comment --comment "ldap"   -j ACCEPT
-A RH-Firewall-1-INPUT -m state --state NEW -m tcp -p tcp --dport 636 --source 131.156.85.0/24 -m comment --comment "ldaps"  -j ACCEPT
#
#-A RH-Firewall-1-INPUT -p udp -m udp --dport 8649 --source 131.156.85.0/24   -m comment --comment "ganglia gmond, udp" -j ACCEPT
