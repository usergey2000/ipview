#-A RH-Firewall-1-INPUT -p tcp -m tcp --dport 8651 --source 10.0.0.0/8        -m comment --comment "ganglia gmetad, tcp" -j ACCEPT
#
-A RH-Firewall-1-INPUT -j REJECT --reject-with icmp-host-prohibited
