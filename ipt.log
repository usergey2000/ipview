# Firewall configuration written by system-config-securitylevel
# Manual customization of this file is not recommended.
*nat
:PREROUTING ACCEPT [284797:12896604]
:INPUT ACCEPT [1512:911230]
:OUTPUT ACCEPT [652:69875]
:POSTROUTING ACCEPT [181:33417]
-A POSTROUTING -o ens4f0np0 -j MASQUERADE
COMMIT
*filter
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:RH-Firewall-1-INPUT - [0:0]
-A INPUT -j RH-Firewall-1-INPUT
#For use with bridges
#ens8 - public, and ens3 - private
#ens4f0np0 - public, bond0 - private
-A FORWARD -i ens4f0np0 -o bond0  -m state --state RELATED,ESTABLISHED -j ACCEPT
-A FORWARD -i bond0 -o ens4f0np0  -j ACCEPT
#
-A FORWARD -j RH-Firewall-1-INPUT
-A RH-Firewall-1-INPUT -m state --state RELATED,ESTABLISHED -j ACCEPT
-A RH-Firewall-1-INPUT -i lo   -j ACCEPT
-A RH-Firewall-1-INPUT -p icmp -j ACCEPT
#
# Allow all connections from "friendly" local networks
#172.23.0.0/16 - cluster admin, 10.148.0.0/16 - cluster ib, 10.0.33.0/24 - ITS public, 131.156.170.0/24 - NIU Metis public
-A RH-Firewall-1-INPUT -s  131.156.170.0/24       -j ACCEPT
-A RH-Firewall-1-INPUT -s  172.23.0.0/16          -j ACCEPT
-A RH-Firewall-1-INPUT -s  10.0.33.0/24           -j ACCEPT
-A RH-Firewall-1-INPUT -s  10.148.0.0/16          -j ACCEPT
#Physics network
-A RH-Firewall-1-INPUT -s  131.156.85.0/24        -j ACCEPT
